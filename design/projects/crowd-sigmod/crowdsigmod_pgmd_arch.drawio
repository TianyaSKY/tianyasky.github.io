        </mxCell>
        <mxCell id="out_count" value="&lt;b style=&quot;font-size:16px; color:#0055AA;&quot;&gt;Estimated Count N&lt;br&gt;&lt;span style=&quot;font-size:12px; color:#333;&quot;&gt;(Exact Sum, No FC Layer)&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8D7F9;strokeColor=#0055AA;strokeWidth=1.8;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1415" y="855" width="210" height="50" as="geometry"/>
        </mxCell>

      </root>
