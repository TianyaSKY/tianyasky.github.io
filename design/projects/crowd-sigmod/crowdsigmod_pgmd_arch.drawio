        <!-- P4 Projection (1x1 + Upsample 4x) -->
        <mxCell id="fus_proj_p4" value="&lt;b&gt;1×1 Proj + Up 4×&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal;&quot;&gt;40×40 → 160×160&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCAA;strokeColor=#000000;strokeWidth=1.2;fontFamily=Arial;fontSize=11;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="710" y="272" width="130" height="40" as="geometry"/>
        </mxCell>
        <!-- Arrow P4 -> Proj -->
        <mxCell id="e_p4_to_proj" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="292" as="sourcePoint"/>
            <mxPoint x="710" y="292" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Channel Concat (64*3 = 192 ch) -->
        <mxCell id="fus_concat" value="&lt;b&gt;Concat (192 ch)&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal;&quot;&gt;P2 + P3↑ + P4↑&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD2A5;strokeColor=#000000;strokeWidth=1.2;fontFamily=Arial;fontSize=12;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="860" y="442" width="110" height="40" as="geometry"/>
        </mxCell>
        <!-- Arrows to Concat -->
        <mxCell id="e_p2_to_cat" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="632" as="sourcePoint"/>
            <mxPoint x="860" y="470" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="850" y="632"/>
              <mxPoint x="850" y="470"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_p3_to_cat" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="462" as="sourcePoint"/>
            <mxPoint x="860" y="462" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_p4_to_cat" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="292" as="sourcePoint"/>
            <mxPoint x="860" y="452" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="850" y="292"/>
              <mxPoint x="850" y="452"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 1x1 Conv + Residual C2f Fusion (128 ch) -->
        <mxCell id="e_cat_to_fuse" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="915" y="442" as="sourcePoint"/>
            <mxPoint x="915" y="380" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="fus_c2f" value="&lt;b&gt;1×1 Conv + ResidualC2f&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Fusion Feature &lt;b style=&quot;color:#0055AA;&quot;&gt;F [128, 160, 160]&lt;/b&gt;&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8D7F9;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;fontSize=12;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="800" y="325" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Branch 1: Probability Head (Top of Column 2) -->
        <mxCell id="e_f_to_prob" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="885" y="325" as="sourcePoint"/>
            <mxPoint x="885" y="235" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="head_prob" value="&lt;b&gt;Probability Head&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal;&quot;&gt;Conv 3×3 (64) → Conv 3×3 (32)&lt;br&gt;→ 1×1 Logit + Sigmoid&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD2A5;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;fontSize=12;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="790" y="165" width="185" height="70" as="geometry"/>
        </mxCell>


        <!-- ================= 5. ENHANCEMENT & DENSITY HEAD ================= -->
        <!-- PGA Module Block in Main Flow -->
        <mxCell id="main_pga" value="&lt;b style=&quot;font-size:13px; color:#0055AA;&quot;&gt;Probability-Guided Attention (PGA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;ECA Channel + [P, Mean, Max] Spatial Gate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#000000;strokeWidth=1.4;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1035" y="325" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- Connection from F to PGA -->
        <mxCell id="e_f_to_pga" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="352" as="sourcePoint"/>
            <mxPoint x="1035" y="352" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Connection from Prob Map P to PGA -->
        <mxCell id="e_prob_to_pga" value="" style="endArrow=classic;endFill=1;strokeColor=#D80000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="975" y="200" as="sourcePoint"/>
            <mxPoint x="1145" y="325" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="1145" y="200"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_p_guidance" value="&lt;b style=&quot;color:#D80000; font-size:12px;&quot;&gt;Prior Map P&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="90" height="20" as="geometry"/>
        </mxCell>

        <!-- Dashed link to PGA detail box (routed around top boundary) -->
        <mxCell id="e_link_pga_detail" value="" style="endArrow=classic;dashed=1;dashPattern=4 4;strokeColor=#333;strokeWidth=1.3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1035" y="340" as="sourcePoint"/>
            <mxPoint x="400" y="240" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="1005" y="340"/>
              <mxPoint x="1005" y="15"/>
              <mxPoint x="400" y="15"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- MSR Refinement Block (x3) -->
        <mxCell id="e_pga_to_msr" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1145" y="380" as="sourcePoint"/>
            <mxPoint x="1145" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="main_msr" value="&lt;b style=&quot;font-size:13px; color:#0055AA;&quot;&gt;MSR Refinement (×3 Blocks)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Multi-Scale Dilated Residuals (r=1, 2, 3)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCAA;strokeColor=#000000;strokeWidth=1.4;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1035" y="440" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- Long Residual Addition: Refined + alpha * F -->
        <mxCell id="e_msr_to_add" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1145" y="495" as="sourcePoint"/>
            <mxPoint x="1145" y="555" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- Long Residual Bypass Curve -->
        <mxCell id="e_long_res" value="" style="curved=1;endArrow=classic;endFill=1;strokeColor=#70AD47;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="365" as="sourcePoint"/>
            <mxPoint x="1255" y="575" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="1000" y="410"/>
              <mxPoint x="1310" y="450"/>
              <mxPoint x="1310" y="575"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lbl_long_res" value="&lt;b style=&quot;color:#548235; font-size:12px;&quot;&gt;+ α_res · F (Long Residual)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1200" y="515" width="160" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="main_res_add" value="&lt;b&gt;Feature Fusion &amp;amp; Detail Merge&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal;&quot;&gt;F_refined = MSR_out + α_res · F&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;fontSize=12;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1035" y="555" width="220" height="42" as="geometry"/>
        </mxCell>

        <!-- Density Head -->
        <mxCell id="e_add_to_den" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1145" y="597" as="sourcePoint"/>
            <mxPoint x="1145" y="650" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="head_density" value="&lt;b&gt;Density Head (Stride 4)&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:normal;&quot;&gt;Conv 3×3 (64) → Conv 3×3 (32)&lt;br&gt;→ 1×1 Conv + &lt;b style=&quot;color:#D80000;&quot;&gt;Softplus (D ≥ 0)&lt;/b&gt;&lt;/span&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C3E8A2;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;fontSize=12;fontColor=#000000;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1035" y="650" width="220" height="65" as="geometry"/>
        </mxCell>


        <!-- ================= 6. OUTPUT PREDICTIONS ================= -->
        <!-- Prob Map Output Box -->
        <mxCell id="out_prob_map" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Probability Map P&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;[B, 1, 160, 160]&lt;br&gt;&lt;i&gt;Crowd Existence Prior&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD2A5;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1430" y="172" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e_prob_to_out" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="975" y="200" as="sourcePoint"/>
            <mxPoint x="1430" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Density Map Output Box -->
        <mxCell id="out_den_map" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Density Map D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;[B, 1, 160, 160] (D ≥ 0)&lt;br&gt;&lt;i&gt;Conservative Point Mass&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C3E8A2;strokeColor=#000000;strokeWidth=1.3;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1430" y="655" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e_den_to_out" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1255" y="682" as="sourcePoint"/>
            <mxPoint x="1430" y="682" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Spatial Sum Integral -->
        <mxCell id="e_den_to_sum" value="" style="endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=2.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1520" y="710" as="sourcePoint"/>
            <mxPoint x="1520" y="765" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="out_sum" value="&lt;b style=&quot;font-size:15px;&quot;&gt;Spatial Sum&lt;br&gt;Σ D(h, w)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#000000;strokeWidth=1.4;fontFamily=Arial;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="1430" y="765" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Final Count Output -->
        <mxCell id="e_sum_to_count" value="" style="endArrow=classic;endFill=1;strokeColor=#0055AA;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1520" y="815" as="sourcePoint"/>
